# ==================== Model Routing ====================
MODEL="nvidia_nim/z-ai/glm4.7"
MODEL_OPUS=
MODEL_SONNET=
MODEL_HAIKU=
ENABLE_MODEL_THINKING=true
ENABLE_OPUS_THINKING=
ENABLE_SONNET_THINKING=
ENABLE_HAIKU_THINKING=

# ==================== NVIDIA NIM ====================
NVIDIA_NIM_API_KEY=***
NVIDIA_NIM_API_KEYS=***
NVIDIA_NIM_KEY_USAGE_LIMIT=0

# ==================== OpenRouter ====================
OPENROUTER_API_KEY=***
OPENROUTER_API_KEYS=***
OPENROUTER_KEY_USAGE_LIMIT=0

# ==================== DeepSeek ====================
DEEPSEEK_API_KEY=***
DEEPSEEK_API_KEYS=***
DEEPSEEK_KEY_USAGE_LIMIT=0

# ==================== FriendliAI ====================
# FRIENDLIAI_API_KEY=***
# FRIENDLIAI_API_KEYS=***
# FRIENDLIAI_KEY_USAGE_LIMIT=0

# ==================== Fireworks AI ====================
# FIREWORKS_API_KEY=***
# FIREWORKS_API_KEYS=***
# FIREWORKS_KEY_USAGE_LIMIT=0

# ==================== LM Studio (local) ====================
LM_STUDIO_BASE_URL="http://localhost:1234/v1"

# ==================== Llama.cpp (local) ====================
LLAMACPP_BASE_URL="http://localhost:8080/v1"

# ==================== Ollama (local) ====================
OLLAMA_BASE_URL="http://localhost:11434"

# ==================== vLLM (local) ====================
# VLLM_BASE_URL="http://localhost:8000/v1"

# ==================== Per-Provider Proxy ====================
NVIDIA_NIM_PROXY=""
OPENROUTER_PROXY=""
LMSTUDIO_PROXY=""
LLAMACPP_PROXY=""
FRIENDLIAI_PROXY=""
FIREWORKS_PROXY=""
VLLM_PROXY=""

# ==================== Rate Limits & Timeouts ====================
PROVIDER_RATE_LIMIT=1
PROVIDER_RATE_WINDOW=3
PROVIDER_MAX_CONCURRENCY=5
PROVIDER_MAX_RETRIES=8
PROVIDER_RETRY_BASE_DELAY=2
PROVIDER_RETRY_MAX_DELAY=120
HTTP_READ_TIMEOUT=
HTTP_WRITE_TIMEOUT=10
HTTP_CONNECT_TIMEOUT=10

# ==================== Server ====================
HOST="0.0.0.0"
PORT=8082
ANTHROPIC_AUTH_TOKEN=

# ==================== Security & Diagnostics ====================
LOG_RAW_API_PAYLOADS=false
LOG_RAW_SSE_EVENTS=false
LOG_API_ERROR_TRACEBACKS=false

# ==================== Local Web Tools ====================
ENABLE_WEB_SERVER_TOOLS=false
WEB_FETCH_ALLOWED_SCHEMES=http,https
WEB_FETCH_ALLOW_PRIVATE_NETWORKS=false
