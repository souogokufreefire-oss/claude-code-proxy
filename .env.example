# All Claude model requests are mapped to these models; MODEL is the fallback.
# Format: provider_type/model/name
# Valid providers: nvidia_nim | open_router | deepseek | lmstudio | llamacpp | ollama | friendliai | fireworks | vllm | cliproxyapi | groq | cerebras | together | kimi
# ==================== Model Routing ====================
MODEL="nvidia_nim/z-ai/glm4.7"
MODEL_OPUS=
MODEL_SONNET=
MODEL_HAIKU=
ENABLE_MODEL_THINKING=true
ENABLE_OPUS_THINKING=
ENABLE_SONNET_THINKING=
ENABLE_HAIKU_THINKING=

# ==================== NVIDIA NIM ====================
NVIDIA_NIM_API_KEY=***
NVIDIA_NIM_API_KEYS=***
NVIDIA_NIM_KEY_USAGE_LIMIT=0

# ==================== OpenRouter ====================
OPENROUTER_API_KEY=***
OPENROUTER_API_KEYS=***
OPENROUTER_KEY_USAGE_LIMIT=0

# ==================== DeepSeek ====================
DEEPSEEK_API_KEY=***
DEEPSEEK_API_KEYS=***
DEEPSEEK_KEY_USAGE_LIMIT=0

# ==================== FriendliAI ====================
# FRIENDLIAI_API_KEY=***
# FRIENDLIAI_API_KEYS=***
# FRIENDLIAI_KEY_USAGE_LIMIT=0

# ==================== Fireworks AI ====================
# FIREWORKS_API_KEY=***
# FIREWORKS_API_KEYS=***
# FIREWORKS_KEY_USAGE_LIMIT=0

# ==================== Groq ====================
# GROQ_API_KEY=***
# GROQ_API_KEYS=***
# GROQ_KEY_USAGE_LIMIT=0
# Optional override for the Groq endpoint (empty uses https://api.groq.com/openai/v1).
# GROQ_BASE_URL=

# ==================== Cerebras ====================
# CEREBRAS_API_KEY=***
# CEREBRAS_API_KEYS=***
# CEREBRAS_KEY_USAGE_LIMIT=0

# ==================== Together AI ====================
# TOGETHER_API_KEY=***
# TOGETHER_API_KEYS=***
# TOGETHER_KEY_USAGE_LIMIT=0

# ==================== Kimi / Moonshot ====================
# KIMI_API_KEY=***
# KIMI_API_KEYS=***
# KIMI_KEY_USAGE_LIMIT=0

# ==================== LM Studio (local) ====================
LM_STUDIO_API_KEY="lm-studio"
LM_STUDIO_BASE_URL="http://localhost:1234/v1"

# ==================== Llama.cpp (local) ====================
LLAMACPP_BASE_URL="http://localhost:8080/v1"

# ==================== Ollama (local) ====================
OLLAMA_BASE_URL="http://localhost:11434"

# ==================== vLLM (local) ====================
# VLLM_BASE_URL="http://localhost:8000/v1"

# ==================== CLIProxyAPI (local, wraps Claude OAuth) ====================
# CLIPROXYAPI_BASE_URL="http://localhost:8317/v1"

# ==================== Per-Provider Proxy ====================
NVIDIA_NIM_PROXY=""
OPENROUTER_PROXY=""
LMSTUDIO_PROXY=""
LLAMACPP_PROXY=""
FRIENDLIAI_PROXY=""
FIREWORKS_PROXY=""
VLLM_PROXY=""
CLIPROXYAPI_PROXY=""
GROQ_PROXY=""
CEREBRAS_PROXY=""
TOGETHER_PROXY=""
KIMI_PROXY=""

# ==================== Rate Limits & Timeouts ====================
PROVIDER_RATE_LIMIT=1
PROVIDER_RATE_WINDOW=3
PROVIDER_MAX_CONCURRENCY=5
PROVIDER_MAX_RETRIES=8
PROVIDER_RETRY_BASE_DELAY=2
PROVIDER_RETRY_MAX_DELAY=120
HTTP_READ_TIMEOUT=
HTTP_WRITE_TIMEOUT=120
HTTP_CONNECT_TIMEOUT=120

# ==================== Server ====================
HOST="0.0.0.0"
PORT=8082
ANTHROPIC_AUTH_TOKEN=***
# JSON log file written by the proxy (relative to the working directory).
LOG_FILE="server.log"
# Optional explicit .env file path; appended last, so it overrides all others.
# Priority: ~/.config/free-claude-code/.env < ~/.config/claude-code-proxy/.env < ./.env < FCC_ENV_FILE
FCC_ENV_FILE=

# ==================== Security & Diagnostics ====================
LOG_RAW_API_PAYLOADS=false
LOG_RAW_SSE_EVENTS=false
LOG_API_ERROR_TRACEBACKS=false
# Minimum severity written to LOG_FILE (DEBUG, INFO, WARNING, ERROR).
LOG_FILE_LEVEL=INFO

# ==================== Local Optimizations ====================
# Answer trivial Claude Code probes locally to save latency and quota.
ENABLE_NETWORK_PROBE_MOCK=true
ENABLE_TITLE_GENERATION_SKIP=true
ENABLE_SUGGESTION_MODE_SKIP=true
ENABLE_FILEPATH_EXTRACTION_MOCK=true
# Fast prefix detection: answer Claude Code command-prefix requests without an API call.
FAST_PREFIX_DETECTION=true

# ==================== Local Web Tools ====================
ENABLE_WEB_SERVER_TOOLS=false
WEB_FETCH_ALLOWED_SCHEMES=http,https
WEB_FETCH_ALLOW_PRIVATE_NETWORKS=false

# ==================== Context Window Manager ====================
# Trim oversized Groq payloads before sending upstream (system prompt, first
# user message, recent messages and complete tool_use/tool_result cycles are
# preserved). Applied only to the Groq provider.
CONTEXT_ENABLED=true
CONTEXT_MAX_TOKENS=24000
CONTEXT_RESERVED_OUTPUT_TOKENS=4096
CONTEXT_MIN_RECENT_MESSAGES=10
